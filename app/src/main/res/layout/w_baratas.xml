<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/w_fondo_claro">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/titulo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingBottom="4dp"
            android:text="Las 3 más baratas" android:textSize="17dp" android:textStyle="bold" android:textColor="#241F31" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/nunito"/>
        <TextView android:id="@+id/refrescar" android:layout_width="40dp" android:layout_height="32dp" android:gravity="center"
            android:text="⟳" android:textSize="22dp" android:textStyle="bold" android:textColor="#1C71D8" android:contentDescription="Actualizar"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/raiz_filas" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <TextView android:id="@+id/vacio" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="Abre la app para ver las gasolineras cercanas" android:visibility="gone"
        android:textSize="15dp" android:textColor="#6F6A78" android:fontFamily="@font/nunito"/>
</LinearLayout>
